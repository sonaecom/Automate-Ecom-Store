# Copy to .env.local. Do not commit .env.local.
# sample uses the files in sample/ and needs no keys.
# csv reads CSV_DIR. sheets reads a private Google Sheet.

DATA_SOURCE=sample
# DATA_SOURCE=csv
# CSV_DIR=./sample
# DATA_SOURCE=sheets
# GOOGLE_SHEETS_ID=
# Prefer an OAuth access token. An API key only works if the sheet is public.
# GOOGLE_SHEETS_ACCESS_TOKEN=
# GOOGLE_SHEETS_API_KEY=
# FX_MODE=custom
# Leave blank for local sample data. Set this before any real store data.
# DASHBOARD_PASSWORD=
